# === Schema Whisperer Configuration ===
# Copy this to .env and fill in your values.

# MongoDB (use your MongoDB Atlas URI when ready, or local Docker)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=whisper_demo

# DataHub (local quickstart or cloud)
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_TOKEN=

# LLM (OpenRouter — reuse your existing key from Astra/Hermes)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v3-flash

# Server
PORT=3400
