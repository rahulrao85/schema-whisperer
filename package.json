{
  "name": "schema-whisperer",
  "version": "1.0.0",
  "description": "Deep MongoDB schema profiling agent for DataHub — discovers rare fields, type conflicts, and schema evolution that DataHub's 1000-doc sample misses",
  "main": "src/api/server.js",
  "scripts": {
    "start": "node src/api/server.js",
    "dev": "node --watch src/api/server.js",
    "seed": "node seeders/seed.js",
    "seed:clean": "node seeders/seed.js",
    "profile": "node scripts/profile-cli.js",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f"
  },
  "keywords": [
    "datahub",
    "mongodb",
    "schema",
    "profiling",
    "mcp",
    "agent",
    "data-quality"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "axios": "^1.7.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.0",
    "mongodb": "^6.0.0"
  }
}
